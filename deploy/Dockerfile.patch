# Reuse the published 0.1.3 dependency layers. Build from
# the repository root: docker build -f deploy/Dockerfile.patch -t myjev:local .
# The root Dockerfile remains the complete installation path.
# This source-only patch inherits pyproject.toml and installed dependencies from
# 0.1.3. Verify that package metadata and dependency requirements are unchanged
# before reusing it. A metadata/dependency change needs the root Dockerfile build.
# Python package 0.1.0 and container 0.1.4 are separate version identifiers.
FROM amitbahree/myjev@sha256:55c78ef13329ab35712e27c9815eff94c17ba1f5fc145bd58eb705d0f16e1f6d
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/bahree/myJEV" org.opencontainers.image.revision=$SOURCE_REVISION org.opencontainers.image.version="0.1.4"
ENV MYJEV_DEVICE=auto OMP_NUM_THREADS=8 MKL_NUM_THREADS=8
WORKDIR /app
COPY src ./src
COPY examples/request.json ./examples/request.json
RUN pip install --no-deps --no-build-isolation .
HEALTHCHECK --interval=30s --start-period=900s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/readyz')"
