# Copy to .env.wandb in the repository root. Keep that local file out of Git.
# Set your W&B account or team and project. No credentials are supplied here.
WANDB_API_KEY=
WANDB_BASE_URL=https://api.wandb.ai
MYJEV_WANDB_ENTITY=your-account-or-team
MYJEV_WANDB_PROJECT=myJEV
# New training processes only: offline, online, or disabled.
MYJEV_TRACKING_MODE=offline
